NODE_ENV=development
PORT=5050
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
RESEND_API_KEY=
# Use onboarding@resend.dev only while testing with your own verified Resend recipient.
# For real OTP delivery, verify a domain in Resend and use an address from that domain here.
RESEND_FROM_EMAIL=onboarding@resend.dev
